{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// DOM lib only for the web-standard globals node shares
		// (AbortController/AbortSignal, timers); no browser-only API may be
		// used in this platform-agnostic package.
		"lib": ["es2022", "dom"],
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
