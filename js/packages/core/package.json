	"keywords": [
		"solana",
		"solana-mobile",
		"seeker",
		"seeker-connect",
		"wallet",
		"web3",
		"mobile-wallet-adapter"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/solana-mobile/seeker-connect.git",
		"directory": "js/packages/core"
	},
	"homepage": "https://github.com/solana-mobile/seeker-connect/tree/main/js/packages/core#readme",
	"type": "module",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
