{
	"name": "@solana-mobile/seeker-connect-react-native",
	"version": "0.1.2",
	"description": "React Native SDK for Seeker Connect: a native module over the Android Seeker Connect SDK.",
	"keywords": [
		"solana",
		"solana-mobile",
		"seeker",
		"seeker-connect",
		"wallet",
		"web3",
		"react-native"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/solana-mobile/seeker-connect.git",
		"directory": "js/packages/react-native"
	},
	"homepage": "https://github.com/solana-mobile/seeker-connect/tree/main/js/packages/react-native#readme",
	"type": "module",
	"files": [
		"dist",
		"android/build.gradle",
		"android/gradle.properties",
		"android/src/main"
	],
	"publishConfig": {
