	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@eslint/js": "^10.0.1",
		"agent-browser": "^0.33.2",
		"eslint": "^10.8.0",
		"happy-dom": "^20.0.11",
		"prettier": "^3.9.6",
		"turbo": "^2.10.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	}
